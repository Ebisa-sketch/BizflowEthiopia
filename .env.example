# ==============================================================================
# BizFlow Ethiopia — Environment Configuration
# ==============================================================================

# Core Application Environment
NODE_ENV=development
APP_URL=http://localhost:3000

# CORS / Mobile App Origins (comma-separated allowed origins)
# In development, localhost origins are allowed automatically.
# Example: https://pos.bizflow.et,https://admin.bizflow.et
MOBILE_APP_ORIGINS=

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# For local Docker:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/bizflow_ethiopia?schema=public"
# For Neon / Cloud PostgreSQL with PgBouncer connection pooling:
# DATABASE_URL="postgresql://user:pass@ep-host-pooler.region.neon.tech/neondb?sslmode=require&channel_binding=require&pgbouncer=true&connect_timeout=15&connection_limit=10"

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# In production, JWT_SECRET MUST be a cryptographically random string (min 32 chars).
# Generate with: openssl rand -base64 48
JWT_SECRET="bizflow_development_super_secret_jwt_key_change_in_production_min_32_chars"
# Token lifetime: format is <integer><unit> where unit is s, m, h, d, w, y (e.g., 7d, 12h)
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# Transactional Email (Password Reset, Z-Reports, Invoices)
# ------------------------------------------------------------------------------
# Option A: Resend API (HTTP POST, zero-dependencies)
# RESEND_API_KEY="re_123456789abcdef"

# Option B: Standard SMTP (Gmail, SendGrid, Amazon SES, Postmark)
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT=587
# SMTP_USER="postmaster@yourdomain.et"
# SMTP_PASS="your-smtp-password"
# SMTP_SECURE="false"
# SMTP_FROM="BizFlow Ethiopia <noreply@bizflow.et>"

# ------------------------------------------------------------------------------
# Distributed Rate Limiting (Multi-container / Edge / Serverless)
# ------------------------------------------------------------------------------
# Optional: Upstash Redis REST credentials. When provided, rate-limiting is shared
# across multiple server instances; otherwise in-memory sliding window is used.
# UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ------------------------------------------------------------------------------
# Production Error Monitoring (Sentry)
# ------------------------------------------------------------------------------
# SENTRY_DSN="https://publicKey@o123456.ingest.sentry.io/7891011"

# ------------------------------------------------------------------------------
# Localization & Currency
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_CURRENCY="ETB"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_SUPPORTED_LOCALES="en,am,om"
