# Environment
NODE_ENV=development
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bizflow_ethiopia?schema=public"

# Authentication & Security
# Production requires an explicitly configured JWT_SECRET of at least 32 characters.
JWT_SECRET="bizflow_development_super_secret_jwt_key_change_in_production_min_32_chars"
# Token lifetime: an integer followed by s, m, h, d, w, or y.
JWT_EXPIRES_IN="7d"

# Default Locale & Currency
NEXT_PUBLIC_DEFAULT_CURRENCY="ETB"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_SUPPORTED_LOCALES="en,am,om"
